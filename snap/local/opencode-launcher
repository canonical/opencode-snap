#!/bin/sh
set -eu

arch="$(uname -m)"

case "$arch" in
    x86_64)
        base="$SNAP/lib/node_modules/opencode-snap-wrapper/node_modules"
        fast="$base/opencode-linux-x64/bin/opencode"
        baseline="$base/opencode-linux-x64-baseline/bin/opencode"
        if grep -qiE '(^|[[:space:]])avx2([[:space:]]|$)' /proc/cpuinfo; then
            exec "$fast" "$@"
        fi
        exec "$baseline" "$@"
        ;;
    aarch64)
        exec "$SNAP/lib/node_modules/opencode-snap-wrapper/node_modules/opencode-linux-arm64/bin/opencode" "$@"
        ;;
    *)
        echo "Unsupported architecture: $arch" >&2
        exit 1
        ;;
esac
