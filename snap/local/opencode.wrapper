#!/bin/sh
# Wrapper script for opencode to unset SNAP environment variables

# Save the path to the actual binary and prepend the snap's bundled
# clipboard tools (wl-copy / wl-paste) to PATH so CLI copy-to-clipboard works.
BIN="$SNAP/bin/opencode"
PATH="$SNAP/usr/bin:$PATH"
export PATH

# snapd gives classic snaps a complain-mode (log-only) AppArmor profile whose
# label is inherited by everything opencode spawns. If a child is itself a
# snap (e.g. `juju debug-log > file`), snap-confine rejects file descriptors
# that were opened under opencode's label, so redirection fails with "bad file
# descriptor" (see canonical/pi-coding-agent-snap#26, LP: #1849753). Arm
# AppArmor's onexec transition so opencode, and everything it spawns, runs
# unconfined as it would outside the snap. Only act under our own
# complain-mode label; ignore any failure.
if [ -e /proc/self/attr/apparmor/current ]; then
    ATTR_DIR=/proc/self/attr/apparmor
else
    ATTR_DIR=/proc/self/attr
fi
LABEL=
{ read -r LABEL < "$ATTR_DIR/current"; } 2>/dev/null || :
case "$LABEL" in
    "snap.${SNAP_INSTANCE_NAME:-opencode}."*" (complain)")
        { printf 'exec unconfined' > "$ATTR_DIR/exec"; } 2>/dev/null || :
        ;;
esac
unset ATTR_DIR LABEL

# Unset all environment variables starting with SNAP
for var in $(env | cut -d= -f1 | grep '^SNAP'); do
    unset "$var"
done

exec "$BIN" "$@"
