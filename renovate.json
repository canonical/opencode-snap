{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranchPatterns": [
    "1.x",
    "2.x"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__fixtures__/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update opencode version in snapcraft.yaml",
      "managerFilePatterns": [
        "snap/snapcraft\\.yaml"
      ],
      "matchStrings": [
        "source-tag:\\s*v(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "anomalyco/opencode",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update opencode source-commit in snapcraft.yaml (v2 dev branch)",
      "managerFilePatterns": [
        "snap/snapcraft\\.yaml"
      ],
      "matchStrings": [
        "source-commit:\\s*(?<currentValue>[a-f0-9]{40})"
      ],
      "datasourceTemplate": "github-commits",
      "depNameTemplate": "anomalyco/opencode",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update opencode version in task.yaml",
      "managerFilePatterns": [
        "tests/smoke/opencode/task\\.yaml"
      ],
      "matchStrings": [
        "opencode --version 2>&1 \\| MATCH \"(?<currentValue>[0-9.]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "anomalyco/opencode",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update bun",
      "managerFilePatterns": [
        "snap/snapcraft\\.yaml"
      ],
      "matchStrings": [
        "https://github\\.com/oven-sh/bun/releases/download/bun-v(?<currentValue>[^/]+)/bun-linux-"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "oven-sh/bun",
      "extractVersionTemplate": "^bun-v(?<version>.+)$",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "packageRules": [
    {
      "description": "Keep 1.x on the opencode 1.x line",
      "matchBaseBranches": [
        "1.x"
      ],
      "matchPackageNames": [
        "anomalyco/opencode"
      ],
      "allowedVersions": "<2"
    },
    {
      "description": "Keep 2.x on the opencode 2.x line",
      "matchBaseBranches": [
        "2.x"
      ],
      "matchPackageNames": [
        "anomalyco/opencode"
      ],
      "allowedVersions": "<3"
    }
  ]
}
