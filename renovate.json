{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update anomalyco/opencode",
      "managerFilePatterns": [
        "snap/snapcraft.yaml"
      ],
      "matchStrings": [
        "https://github\\.com/anomalyco/opencode/releases/download/(?<currentValue>v[^/]+)/opencode-linux"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "anomalyco/opencode",
      "versioningTemplate": "semver"
    }
  ]
}
